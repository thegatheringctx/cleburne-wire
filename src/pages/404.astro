---
import Base from "../layouts/Base.astro";
Astro.response.status = 404;
---
<Base title="Page not found — Cleburne Wire">
  <header class="page-head"><h1>We couldn't find that page.</h1><p class="dek">It may have moved, or the story was taken down. Try a search, or start from today's news.</p></header>
  <div class="single">
    <form class="search-form" method="get" action="/search"><input name="q" placeholder="Search Cleburne Wire" aria-label="Search" autofocus /><button class="btn">Search</button></form>
    <div class="util-grid" style="margin-top:1.4rem">
      <div class="util"><b>Today's news</b><a href="/cleburne">Top stories</a></div>
      <div class="util"><b>This week</b><a href="/cleburne/events">Events calendar</a></div>
      <div class="util"><b>Find a place</b><a href="/cleburne/guide">The Guide</a></div>
      <div class="util"><b>Yellow Jackets</b><a href="/cleburne/sports">Sports</a></div>
    </div>
  </div>
</Base>
