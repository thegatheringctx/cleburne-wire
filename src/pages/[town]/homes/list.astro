---
import Base from "../../../layouts/Base.astro";
import Page from "../../../components/Page.astro";
import { getTown } from "../../../lib/db";
const town = await getTown(Astro.params.town!); if (!town) return Astro.redirect("/cleburne");
const done = Astro.url.searchParams.get("done") === "1";
Astro.response.headers.set("Cache-Control", "private, no-store");
---
<Base title={`Add a listing or open house — ${town.name} Wire`} {town}>
  <Page {town} title={done ? "Your listing is live." : "Add a listing or open house"} dek={done ? "It's on the Homes page now, and an open house also appears on the events calendar." : `Free for licensed agents with ${town.name} listings. Shows on the Homes page for 45 days; open houses also go on the events calendar and weekend guide.`} rail={false}>
    {done ? <p><a class="btn" href={`/${town.slug}/homes`}>See it on the Homes page</a> <a class="btn ghost" href={`/${town.slug}/homes/list`}>Add another</a></p> :
    <form class="card" method="post" action="/api/listing">
      <input type="hidden" name="town" value={town.slug} />
      <label>Property address<input name="address" required maxlength="160" placeholder={`123 Main St, ${town.name}, TX 76031`} /></label>
      <div class="mcalc">
        <label>Price<input name="price" type="number" inputmode="numeric" placeholder="325000" /></label>
        <label>Beds<input name="beds" type="number" step="0.5" /></label>
        <label>Baths<input name="baths" type="number" step="0.5" /></label>
        <label>Square feet<input name="sqft" type="number" /></label>
      </div>
      <label>Listing link (your site or MLS page)<input name="url" placeholder="https://" maxlength="500" /></label>
      <label>Photo link (optional, a .jpg or .png address)<input name="photo" placeholder="https://.../photo.jpg" maxlength="500" /></label>
      <div class="mcalc">
        <label>Open house starts (optional)<input name="open_at" type="datetime-local" /></label>
        <label>Ends<input name="open_end" type="datetime-local" /></label>
      </div>
      <label>Listing agent<input name="agent" required maxlength="80" /></label>
      <label>Brokerage (required in Texas real estate ads)<input name="brokerage" required maxlength="80" /></label>
      <label>Agent phone<input name="phone" maxlength="30" /></label>
      <label>Agent email (not shown publicly)<input name="email" type="email" required maxlength="200" /></label>
      <input name="company" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px" aria-hidden="true" />
      <button class="btn">Post it</button>
      <p class="fix">By posting you confirm you're the listing agent or have the listing agent's permission. Want it at the top? Featured listings are available; email news@cleburnewire.com.</p>
    </form>}
  </Page>
</Base>
