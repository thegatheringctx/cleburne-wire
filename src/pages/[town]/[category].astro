---
import Page from "../../components/Page.astro";
import Base from "../../layouts/Base.astro";
import Feed from "../../components/Feed.astro";
import { getBoosts, getTown, getFeed, getAlerts, getCategories } from "../../lib/db";
const town = await getTown(Astro.params.town!); if (!town) return Astro.redirect("/cleburne");
const cats = await getCategories(); const cat = cats.find((c) => c.slug === Astro.params.category);
if (!cat) return Astro.rewrite("/404");
const [raw, alerts] = await Promise.all([getFeed(town.id, cat.slug, cat.slug === "events" ? 200 : 60), getAlerts(town.id)]);
// Events: soonest first, upcoming only (recurring classes collapse to their next date in Feed)
const stories = cat.slug === "events"
  ? raw.filter((s: any) => s.event_at && new Date(s.event_at).getTime() > Date.now() - 36e5).sort((a: any, b: any) => +new Date(a.event_at) - +new Date(b.event_at))
  : raw;
Astro.response.headers.set("Cache-Control", "public, max-age=300, s-maxage=300");

const DEKS: Record<string, string> = {
  news: `Everything happening in ${town.name}, from City Hall to Main Street.`,
  crime: `Arrests, incidents and court outcomes, from law enforcement and local reporting.`,
  roads: `Closures, construction and crashes on the roads ${town.name} drives.`,
  weather: `Today's forecast and active weather alerts for ${town.name}.`,
  government: `City council, the county courthouse and every board that decides how ${town.name} grows.`,
  schools: `School board decisions, campus news and what parents need to know.`,
  sports: `${town.name} Yellow Jackets scores, schedules and stories.`,
  business: `Openings, closings, development and jobs across ${town.name}.`,
  "real-estate": `Land sales, new developments and the local housing market.`,
  events: `What's happening in ${town.name}, soonest first. Recurring classes show their next date.`,
  obituaries: `Recent obituaries from area funeral homes.`,
  community: `People, milestones and good news from around town.`,
  jobs: `Hiring news and openings from local employers.`,
  pets: `Lost and found pets in ${town.name}. Post yours free.`,
};
const boosts = cat.slug === "events" ? await getBoosts(town.id) : [];
const dek = DEKS[cat.slug] ?? `${cat.name} in ${town.name}, TX.`;
---
<Base title={`${cat.name} — ${town.name} Wire`} {town} {alerts} desc={dek}>
  <nav class="cats" aria-label="Sections"><a href={`/${town.slug}`}>Top stories</a>
    {cats.filter((c) => ["news","crime","government","schools","sports","events","business","obituaries"].includes(c.slug) || c.slug === cat.slug).map((c) => <a href={`/${town.slug}/${c.slug}`} aria-current={c.slug === cat.slug ? "page" : undefined}>{c.name}</a>)}</nav>
  <Page {town} title={cat.name} {dek} railProps={{ events: cat.slug !== "events" }}>
    {boosts.length > 0 && <div class="boosts">{boosts.map((b) => <a class="boost" href={`/go/${b.id}`} rel="sponsored"><span>Featured event</span><b>{b.headline}</b><small>{b.body}</small></a>)}</div>}
    {cat.slug === "pets" && stories.length === 0 ? <div class="empty-cta"><b>Lost a pet, or found one?</b><p>Post it free. It goes on this page, in the morning email and on our Facebook page, usually within the hour.</p><a class="btn" href="/submit?kind=lost_pet">Post a lost or found pet</a></div> : <Feed {stories} {town} category={cat.slug} />}
  </Page>
</Base>
