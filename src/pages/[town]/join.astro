---
// Signup landing page for ads and shares: one job, get an email address. Shows a live taste of this morning's edition
// (top headlines and the forecast) so people see exactly what they're signing up for. Town comes from the URL.
import Base from "../../layouts/Base.astro";
import { getTown, sb, forecast, niceTitle } from "../../lib/db";
import { emailSendingOn } from "../../lib/flags";
const town = await getTown(Astro.params.town!); if (!town) return Astro.redirect("/");
const [{ data: top }, fc, { count: subs }, emailOn] = await Promise.all([
  sb.rpc("top_stories", { p_town: town.slug, p_hours: 48, p_limit: 10 }),
  forecast(town),
  sb.rpc("subscriber_count").then((r) => ({ count: r.data ?? 0 })),
  emailSendingOn(),
]);
const heads = (top ?? []).filter((s: any) => !["events", "weather", "obituaries", "crime"].includes(s.category)).slice(0, 3);
const day = fc.find((p: any) => p.isDaytime);
Astro.response.headers.set("Cache-Control", "public, max-age=600, s-maxage=600");
---
<Base title={`Get ${town.name} news in your inbox, free — ${town.name} Wire`} {town} desc={`${town.name}'s news, weather, events and Friday night scores in one short email${emailOn ? " every weekday at 7 a.m." : ""}. Free. Unsubscribe anytime.`}>
  <div class="single" style="max-width:40rem;margin:0 auto">
    <header class="page-head" style="text-align:left">
      <h1>{town.name}, in five minutes{emailOn ? " every morning" : ""}.</h1>
      <p class="dek">The day's local news, weather, what's happening this weekend, and {town.team_name ?? "local"} scores in one short email{emailOn ? ", every weekday at 7 a.m." : "."} Free.</p>
    </header>
    <form class="sub-band" method="post" action="/api/subscribe" style="margin-top:0">
      <div><b>Get the {town.name} morning email</b><span>Free. No spam. Unsubscribe with one click.</span></div>
      <div style="display:flex;gap:.5rem;flex-wrap:wrap"><input type="hidden" name="town" value={town.slug} /><input type="email" name="email" required placeholder="Your email" aria-label="Email address" style="flex:1;min-width:12rem" /><button class="btn">Sign me up</button></div>
    </form>
    {(heads.length > 0 || day) && <section style="border:1px solid var(--line,#DCE3EA);border-radius:6px;padding:1rem 1.2rem;margin:1.4rem 0">
      <h3 class="group" style="margin-top:0">What this morning's email looks like</h3>
      {day && <p style="margin:.2rem 0 .8rem"><b>{day.temperature}°</b> and {String(day.shortForecast).toLowerCase()} today in {town.name}.</p>}
      <ul class="plain">{heads.map((h: any) => <li><a href={`/${town.slug}/s/${h.id}`}>{niceTitle(h.title)}</a></li>)}</ul>
      <p class="fix" style="margin-bottom:0">Plus events coming up, obituaries, and the weekend guide on Thursdays.</p>
    </section>}
    <h3 class="group">Why people read it</h3>
    <div class="util-grid">
      <div class="util"><b>Local only</b><span>Just {town.name}: City Hall, schools, roads, restaurants, Friday nights. Nothing national.</span></div>
      <div class="util"><b>Short</b><span>Read it with your coffee. Every story links to its source if you want more.</span></div>
      <div class="util"><b>Free, and easy to leave</b><span>We never sell your email. One click unsubscribes. <a href="/privacy">Privacy policy</a>.</span></div>
    </div>
    {(subs ?? 0) >= 250 && <p class="fix">Join {(subs ?? 0).toLocaleString()} neighbors who already get it.</p>}
  </div>
</Base>
