---
import Base from "../layouts/Base.astro";
import { getTowns } from "../lib/db"; const towns = await getTowns();
const pre = Astro.url.searchParams.get("kind") ?? "event";
const sent = Astro.url.searchParams.get("sent") === "1";
const K = [["event","An event"],["lost_pet","A lost pet"],["found_pet","A found pet"],["garage_sale","A garage or estate sale"],["job","A job opening (free for 30 days)"],["business","A new business"],["tip","A news tip"]];
---
<Base title="Send a tip or post an event, pet, sale or job — Cleburne Wire">
  <header class="page-head"><h1>Tell the town</h1><p class="dek">Events, lost and found pets, garage sales, job openings and news tips. Free, and usually live within the hour after a quick automatic check.</p></header>
  <div class="single">
    {sent && <div class="notice" style="border-left:6px solid var(--gold)"><b>Got it, thank you.</b> Your post is being checked and usually goes live within the hour. Have another? Send it below.</div>}
    <form class="card" method="post" action="/api/submit">
      <input type="text" name="website" style="display:none" tabindex="-1" autocomplete="off" />
      <label>What are you sharing?<select name="kind" required>{K.map(([v, l]) => <option value={v} selected={v === pre}>{l}</option>)}</select></label>
      <input type="hidden" name="town" value={towns[0]?.slug ?? "cleburne"} />
      <label>Headline<input name="title" placeholder="Fall Festival at Hulen Park" required maxlength="120" /></label>
      <label>Details<textarea name="details" rows="5" required placeholder="What, who it's for, cost, anything people should know"></textarea></label>
      <label>When (if it applies)<input name="when" placeholder="Saturday, Oct. 10, 8 to 11 a.m." /></label>
      <label>Where (if it applies)<input name="where" placeholder="Address or place" /></label>
      <label>Your name<input name="name" /></label>
      <label>Your email (not published)<input name="email" type="email" required /></label>
      <label>Phone (optional, not published)<input name="phone" /></label>
      <button class="btn">Send it in</button>
      <p class="fix">Prefer email? Send it to <a href="mailto:news@cleburnewire.com">news@cleburnewire.com</a>. Churches can <a href="/cleburne/faith/add">add or update their listing here</a>.</p>
    </form>
  </div>
</Base>
