---
import Base from "../../layouts/Base.astro";
---
<Base title="Welcome aboard, sponsor">
  <header class="page-head"><h1>Thank you. You're live.</h1><p class="dek">Your placement turns on automatically within a few minutes, built from your business name and website.</p></header>
  <div class="single">
    <div class="util-grid">
      <div class="util"><b>Change your ad</b><span>Send a different line, a logo or a special offer to news@cleburnewire.com.</span></div>
      <div class="util"><b>See your results</b><span>Your private results page arrives by email within a day, and a report on the 1st of every month.</span></div>
      <div class="util"><b>Cancel anytime</b><span>Use the link in your Stripe receipt. No contracts.</span></div>
    </div>
    <p><a class="btn" href="/cleburne">See Cleburne Wire</a></p>
  </div>
</Base>
