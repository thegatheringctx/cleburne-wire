---
import Base from "../../layouts/Base.astro";
import BizRow from "../../components/BizRow.astro";
import { sb } from "../../lib/db";
// The advertise page sells the primary (first-launched) active town. Name, slug and team come from the towns table.
const { data: T } = await sb.from("towns").select("name,slug,team_name").eq("active", true).order("created_at").limit(1).maybeSingle();
const town = T ?? { name: "Cleburne", slug: "cleburne", team_name: null };
const L = {
  boost: "https://buy.stripe.com/9B67sEgcQaj57DXfkDco004",
  listing: "https://buy.stripe.com/9B6aEQ4u80Iv2jDfkDco003",
  partner: "https://buy.stripe.com/cNi6oAgcQ4YLbUdegzco005",
  section: "https://buy.stripe.com/4gM28k3q4aj50bv6O7co006",
  email: "https://buy.stripe.com/14A5kw4u876T3nHb4nco007",
};
const [{ data: taken }, { count: subs }, { count: founders }, { count: biz }, { count: partners }] = await Promise.all([
  sb.from("ads").select("category,placement").eq("active", true).in("placement", ["category-sponsor", "newsletter"]),
  sb.rpc("subscriber_count").then((r) => ({ count: r.data ?? 0 })),
  sb.from("sponsors").select("id", { count: "exact", head: true }).eq("active", true),
  sb.from("businesses").select("id", { count: "exact", head: true }).eq("active", true),
  sb.from("sponsors").select("id", { count: "exact", head: true }).eq("active", true).eq("plan", "partner"),
]);
const partnersLeft = Math.max(0, 5 - (partners ?? 0));
const sold = new Set((taken ?? []).filter((a) => a.placement === "category-sponsor").map((a) => a.category));
const emailSold = (taken ?? []).some((a) => a.placement === "newsletter" && a.category === "presenting");
const SECTIONS = [["obituaries", "Obituaries"], ["homes", "Homes and money"], ["meetings", "Public meetings"], ["weekend", "Weekend guide"]];
const open = SECTIONS.filter(([k]) => !sold.has(k));
const foundingLeft = Math.max(0, 10 - (founders ?? 0));
const readers = (await sb.rpc("readers_30d")).data ?? 0;
// Email placements are only sold while the morning email is actually sending (app_settings.email_sending = 'on').
const emailOn = (await sb.rpc("email_sending_on")).data !== false;
// Real numbers, always shown: an advertiser should see the audience before paying, even while it is small.
const { data: pv30 } = await sb.rpc("site_stats_30d");
// Game Day (sports sponsorship): one sponsor at a time; its payment link lives in app_settings.public_link_gameday.
const { data: gameDayLink } = await sb.rpc("public_setting", { p_key: "public_link_gameday" });
const gameDaySold = sold.has("sports");
const team = town.team_name ?? "Game";
const stats = (pv30 ?? {}) as any;
Astro.response.headers.set("Cache-Control", "public, max-age=300, s-maxage=300");
---
<Base title={`Advertise on ${town.name} Wire: reach ${town.name} every day`} desc={`Sponsor ${town.name}'s daily local news. Event boosts from $25, featured listings from $30 a month, and exclusive section sponsorships. Founding rates, cancel anytime.`}>
  <header class="page-head"><h1>Reach {town.name} every day</h1>
    <p class="dek">{town.name} Wire covers the news, scores, meetings and weekend plans for {town.name}, plus a guide to {(biz ?? 0).toLocaleString()} local businesses. Put yours in front of neighbors, not strangers.</p></header>

  <div class="notice" style="margin-bottom:1.2rem"><b>Your business may already be listed, free.</b> Search for it, then add your photo, hours and website at no cost.
    <form method="get" action="/search" style="display:flex;gap:.5rem;margin-top:.6rem;flex-wrap:wrap"><input name="q" placeholder="Your business name" aria-label="Your business name" style="flex:1;min-width:12rem;padding:.6rem;border:1px solid var(--line,#DCE3EA);border-radius:4px" /><button class="btn" type="submit">Find my listing</button></form></div>

  {foundingLeft > 0 && <div class="founding"><b>Founding sponsor rate.</b> Sign up now and keep today's price for 12 months. Month to month, cancel anytime.</div>}

  <section class="tiers">
    <div class="tier"><span class="t-name">Event Boost</span><div class="t-price">$25<small> one time</small></div>
      <ul><li>Your event at the top of Events and the Weekend Guide</li><li>Runs 2 weeks</li><li>Great for fundraisers, openings and shows</li></ul>
      <a class="btn ghost" href={L.boost}>Boost an event</a></div>
    <div class="tier"><span class="t-name">Featured Listing</span><div class="t-price">$30<small>/mo</small></div>
      <ul><li>Top of your category in the Guide, with a Featured badge</li><li>Your hours, phone and directions front and center</li><li>Shown to people ready to buy</li></ul>
      <a class="btn ghost" href={L.listing}>Get featured</a></div>
    <div class="tier"><span class="t-name">{team} Game Day</span><div class="t-price">$99<small>/mo</small></div>
      <ul><li>"Presented by" your business on the {town.name} sports page</li><li>Your name on every game-day preview and final-score recap, which also post to Facebook</li><li>Top of the Monday sports roundup in the morning email</li><li>One sponsor at a time</li></ul>
      <p class="avail">{gameDaySold ? "Taken. Ask to join the waitlist." : "Available now"}</p>
      {gameDaySold ? <a class="btn ghost" href="mailto:news@cleburnewire.com?subject=Game%20Day%20waitlist">Join the waitlist</a>
        : gameDayLink ? <a class="btn ghost" href={gameDayLink}>Sponsor game day</a>
        : <a class="btn ghost" href={`mailto:news@cleburnewire.com?subject=${encodeURIComponent(`${team} Game Day sponsorship`)}`}>Ask about game day</a>}</div>
    <div class="tier best"><span class="t-flag">Best value</span><span class="t-name">Local Partner</span><div class="t-price">$149<small>/mo</small></div>
      <ul><li>Everything in Featured Listing</li><li>Your ad across the site, in the news feed and sidebar</li>{emailOn && <li>Your own day in the morning email every week (5 partners max)</li>}<li>Live results page, yours the moment you pay</li></ul>
      <p class="avail">{partnersLeft ? "Limited to 5 businesses" : "All 5 spots are taken. Ask to join the waitlist."}</p>
      {partnersLeft ? <a class="btn" href={L.partner}>Become a Local Partner</a> : <a class="btn ghost" href="mailto:news@cleburnewire.com?subject=Local%20Partner%20waitlist">Join the waitlist</a>}</div>
    <div class="tier"><span class="t-name">Section Sponsor</span><div class="t-price">$249<small>/mo</small></div>
      <ul><li>"Presented by" on one whole section, one sponsor each</li><li>Your name on every page of that section, all month, on phones and desktop</li></ul>
      <p class="avail">{open.length ? <>Open: {open.map(([, n]) => n).join(", ")}</> : "All sections are taken. Ask to join the waitlist."}</p>
      {open.length > 0 ? <a class="btn ghost" href={L.section}>Claim a section</a> : <a class="btn ghost" href="mailto:news@cleburnewire.com?subject=Section%20waitlist">Join the waitlist</a>}</div>
    {emailOn && <div class="tier"><span class="t-name">Morning Email Presenting Sponsor</span><div class="t-price">$299<small>/mo</small></div>
      <ul><li>The top slot in every weekday morning email</li><li>One sponsor only</li><li>The first thing {town.name} reads at 7</li></ul>
      <p class="avail">{emailSold ? "Taken. Ask to join the waitlist." : "Available now"}</p>
      {emailSold ? <a class="btn ghost" href="mailto:news@cleburnewire.com?subject=Email%20sponsor%20waitlist">Join the waitlist</a> : <a class="btn ghost" href={L.email}>Present the morning email</a>}</div>}
  </section>

  <div class="single">
    <h3 class="group">What $30 a month looks like</h3>
    <p style="margin-top:0">A Featured Listing sits at the top of its category in the Guide, above every free listing, with a Featured badge. Example:</p>
    <div class="featured-example" aria-label="Example featured listing" style="pointer-events:none;user-select:none">
      <BizRow b={{ slug: "", name: "Your Business Name", tier: "featured", category: "restaurants", address: `123 Main St, ${town.name}, TX`, phone: "8175550100", description: "Your one-line description, written from your website. Change it anytime.", image_url: null, rating: 4.8, rating_count: 126 }} i={0} town={{ slug: town.slug }} />
    </div>
    <p style="font-size:.9rem;color:var(--muted,#5B6878)">Example only. Your real name, hours, phone, photo and reviews appear on yours.</p>

    <h3 class="group">Why it works</h3>
    <div class="util-grid">
      <div class="util"><b>Local, not national</b><span>Built only for {town.name}: local news, the local Guide, and local events. Your ad isn't competing with national brands.</span></div>
      <div class="util"><b>See your results</b><span>A private page shows how often your ad was seen and clicked, updated live. You get the link the moment you pay.</span></div>
      <div class="util"><b>No contracts</b><span>Month to month. Cancel from your receipt anytime.</span></div>
      <div class="util"><b>Live the same day</b><span>Pay online and your ad goes up automatically, built from your business name and website. Email changes anytime.</span></div>
    </div>
    <h3 class="group">The audience today</h3>
    <p style="margin-top:0">{town.name} Wire launched in September 2026 and is growing. These are the real numbers for the last 30 days, updated live:</p>
    <div class="util-grid">
      <div class="util gold"><b style="font-size:2.2rem">{Number(stats.readers ?? readers ?? 0).toLocaleString()}</b><span>people visited the site</span></div>
      <div class="util gold"><b style="font-size:2.2rem">{Number(stats.views ?? 0).toLocaleString()}</b><span>pages viewed</span></div>
      <div class="util"><b style="font-size:2.2rem">{(subs ?? 0).toLocaleString()}</b><span>morning email subscribers</span></div>
      <div class="util"><b style="font-size:2.2rem">{(biz ?? 0).toLocaleString()}</b><span>local businesses in the Guide</span></div>
    </div>
    <p style="font-size:.9rem;color:var(--muted,#5B6878)">Founding rates are priced for a young audience and locked for 12 months. Your results page shows exactly how many people saw and clicked your ad.</p>

    <h3 class="group">Questions</h3>
    <dl class="faq">
      <dt>What does my ad look like?</dt><dd>Your business name, a one-line description and a link, in our site's style so it reads cleanly. We write the first version from your website; send us a different line or a logo anytime at news@cleburnewire.com.</dd>
      <dt>Is my content ever affected by sponsoring?</dt><dd>No. Sponsors never influence what we report. Ads are always labeled.</dd>
      <dt>What won't you run?</dt><dd>Political campaign ads, adult content, vaping or payday lending. We keep it family-friendly.</dd>
      <dt>I'm a mortgage lender or real estate agent. Anything extra?</dt><dd>Send us your NMLS ID (lenders) or your brokerage name (agents) and we include it in your ad. We don't advertise specific rates or "pre-approved" offers.</dd>
      <dt>Can I bundle or pay yearly?</dt><dd>Yes. Email news@cleburnewire.com and we'll set up a custom package.</dd>
    </dl>
  </div>
</Base>
