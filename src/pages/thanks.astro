---
import Base from "../layouts/Base.astro";
import { sb } from "../lib/db";
import { emailSendingOn } from "../lib/flags";
// After signup: (1) follow the town's Facebook page, the moment people are most willing; (2) share their link.
const { data: T } = await sb.from("towns").select("name,slug,profile").eq("active", true).order("created_at").limit(1).maybeSingle();
const town = T ?? { name: "Cleburne", slug: "cleburne", profile: {} };
const fb = (town.profile as any)?.facebook_url as string | undefined;
const code = /^[0-9a-f]{8}$/.test(Astro.url.searchParams.get("c") ?? "") ? Astro.url.searchParams.get("c") : null;
const count = code ? ((await sb.rpc("referral_count", { p_code: code })).data ?? 0) : 0;
const link = code ? `https://cleburnewire.com/r/${code}` : "https://cleburnewire.com";
const msg = `I get ${town.name}'s news every morning from ${town.name} Wire. Free, 5 minutes: ${link}`;
const emailOn = await emailSendingOn();
Astro.response.headers.set("Cache-Control", "private, no-store");
---
<Base title={`You're in. Welcome to ${town.name} Wire`}>
  <header class="page-head"><h1>You're in.</h1><p class="dek">{emailOn ? "Your first morning email arrives at 7 on the next weekday. Check your promotions tab if you don't see it, and move it to your inbox." : "You're on the list. We'll email you when the next edition goes out. Until then, the latest is always on the site."}</p></header>
  <div class="single">
    {fb && <section class="refer-box" style="text-align:center">
      <h2>One more tap: follow us on Facebook</h2>
      <p>Breaking news, game-day scores and weather alerts land there first, between morning emails.</p>
      <a class="btn" href={fb} target="_blank" rel="noopener" style="font-size:1.05rem">Follow {town.name} Wire on Facebook</a>
    </section>}
    <section class="refer-box">
      <h2>Know someone who'd want this?</h2>
      <p>{town.name} Wire grows one neighbor at a time, and every neighbor you bring helps keep it free. Share your personal link below; we count everyone who joins with it.</p>
      <div class="ref-link"><input readonly value={link} aria-label="Your share link" onclick="this.select()" /><button class="btn" type="button" onclick={`navigator.clipboard.writeText('${link}');this.textContent='Copied'`}>Copy</button></div>
      <div class="share-row">
        <a class="sh fb" href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(link)}`} target="_blank" rel="noopener">Share on Facebook</a>
        <a class="sh" href={`sms:?&body=${encodeURIComponent(msg)}`}>Text a friend</a>
        <a class="sh" href={`mailto:?subject=${encodeURIComponent("You'd like this")}&body=${encodeURIComponent(msg)}`}>Email</a>
      </div>
      {code && <p class="fix">{count === 0 ? "No one has joined with your link yet." : `${count} ${count === 1 ? "neighbor has" : "neighbors have"} joined with your link. Thank you.`} Your link is also at the bottom of every morning email.</p>}
    </section>
    <p><a class="btn ghost" href={`/${town.slug}`}>Back to today's news</a></p>
  </div>
  <script is:inline>try{localStorage.setItem("cw_sub","1")}catch(e){}</script>
</Base>
